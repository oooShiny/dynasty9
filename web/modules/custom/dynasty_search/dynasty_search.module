<?php

/**
 * @file
 * Client-side JSON search for the Game Search and Highlight Search pages.
 */

/**
 * Implements hook_theme().
 */
function dynasty_search_theme() {
  return [
    'dynasty_search_game_page' => [
      'variables' => [],
      'template' => 'game-search-page',
    ],
    'dynasty_search_highlight_page' => [
      'variables' => [],
      'template' => 'highlight-search-page',
    ],
    'dynasty_search_plays_page' => [
      'variables' => ['active_mode' => 'plays'],
      'template' => 'plays-search-page',
    ],
    'dynasty_search_player_highlight_block' => [
      'variables' => ['player_nid' => NULL],
      'template' => 'player-highlight-search-block',
    ],
    'dynasty_search_podcast_page' => [
      'variables' => [],
      'template' => 'podcast-search-page',
    ],
  ];
}
