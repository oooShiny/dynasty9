{#
/**
 * @file
 * Shared Highlight Search app shell, included by both the standalone
 * /search/highlights page (highlight-search-page.html.twig) and the
 * player-page embedded block (player-highlight-search-block.html.twig).
 * All data is loaded client-side from /dynasty/search/highlights by
 * js/highlight-search.js — this template only provides the filter
 * controls, sort/fulltext controls, and empty result containers.
 *
 * When `player_nid` is passed (player-page embed), js/highlight-search.js
 * reads it off the data-player-nid attribute below to scope the dataset to
 * that player and hide the (then-redundant) player filter.
 *
 * Single-copy responsive filter panel, same reasoning as
 * game-search-page.html.twig.
 */
#}

{% set play_type_filter %}
  <label for="hs-filter-play-type" class="block text-sm mb-1">Play Type</label>
  <select id="hs-filter-play-type" multiple class="select2-widget w-full" data-select2-config='{"placeholder":"- Select Play Type -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set player_filter %}
  <label for="hs-filter-player" class="block text-sm mb-1">Player</label>
  <select id="hs-filter-player" multiple class="select2-widget w-full" data-select2-config='{"placeholder":"- Select Player -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set play_tag_filter %}
  <label for="hs-filter-play-tag" class="block text-sm mb-1">Play Tag</label>
  <select id="hs-filter-play-tag" multiple class="select2-widget w-full" data-select2-config='{"placeholder":"- Select Tag -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set season_filter %}
  <label for="hs-filter-season" class="block text-sm mb-1">Season</label>
  <select id="hs-filter-season" multiple class="select2-widget w-full" data-select2-config='{"placeholder":"- Select Season(s) -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set opponent_filter %}
  <label for="hs-filter-opponent" class="block text-sm mb-1">Opponent</label>
  <select id="hs-filter-opponent" multiple class="select2-widget w-full" data-select2-config='{"placeholder":"- Select Opponent -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set down_filter %}
  <label for="hs-filter-down" class="block text-sm mb-1">Down</label>
  <select id="hs-filter-down" multiple class="select2-widget w-full" data-select2-config='{"placeholder":"- Select Down -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set week_filter %}
  <label for="hs-filter-week" class="block text-sm mb-1">Week</label>
  <select id="hs-filter-week" multiple class="select2-widget w-full" data-select2-config='{"placeholder":"- Select Week -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set quarter_filter %}
  <label for="hs-filter-quarter" class="block text-sm mb-1">Quarter</label>
  <select id="hs-filter-quarter" multiple class="select2-widget w-full" data-select2-config='{"placeholder":"- Select Quarter -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set td_filter %}
  <div class="text-sm mb-1">TD Scored</div>
  <div class="hs-toggle-group flex gap-1" data-filter="td_scored">
    <button type="button" class="hs-toggle px-3 py-1 border rounded" data-value="">All</button>
    <button type="button" class="hs-toggle px-3 py-1 border rounded" data-value="1">Yes</button>
    <button type="button" class="hs-toggle px-3 py-1 border rounded" data-value="0">No</button>
  </div>
{% endset %}

{% set range_filters %}
  <div class="mb-8">
    <div class="text-sm mb-4">Yards Gained</div>
    <div id="hs-slider-yards" class="bef-slider"></div>
    <div class="slider-min-max-labels"><span class="min-label"></span><span class="max-label"></span></div>
  </div>
  <div class="mb-4">
    <div class="text-sm mb-4">Air Yards</div>
    <div id="hs-slider-air-yards" class="bef-slider"></div>
    <div class="slider-min-max-labels"><span class="min-label"></span><span class="max-label"></span></div>
  </div>
{% endset %}

{% set reset_filter %}
  <button type="button" id="hs-reset" class="w-full px-3 py-2 bg-red-pats text-white rounded">Reset Search</button>
{% endset %}

<div id="highlight-search-app" class="mx-auto"{% if player_nid %} data-player-nid="{{ player_nid }}"{% endif %}>
  <div class="flex flex-wrap md:!flex-nowrap gap-4">
    <div class="w-full md:!w-1/4">
      <h2 id="hs-filter-toggle" class="md:!hidden bg-gray-500 font-light p-2 text-center text-white text-xl uppercase" style="cursor: pointer">Filters &#9660;</h2>
      <div id="hs-filters-panel" class="hidden md:!block bg-blue-pats text-gray-300 border border-gray-400 p-2 shadow-lg divide-y">
        <div class="p-3">{{ play_type_filter }}</div>
        <div class="p-3" id="hs-filter-player-wrapper">{{ player_filter }}</div>
        <div class="p-3">{{ play_tag_filter }}</div>
        <div class="p-3">{{ season_filter }}</div>
        <div class="p-3">{{ opponent_filter }}</div>
        <div class="p-3">{{ down_filter }}</div>
        <div class="p-3">{{ week_filter }}</div>
        <div class="p-3">{{ quarter_filter }}</div>
        <div class="p-3">{{ td_filter }}</div>
        <div class="p-3">{{ range_filters }}</div>
        <div class="p-3">{{ reset_filter }}</div>
      </div>
    </div>

    <div class="w-full md:!w-3/4 min-w-0">
      <div class="flex flex-wrap items-center justify-between px-2 gap-2">
        <div id="hs-active-filters" class="flex flex-wrap gap-2"></div>
        <div class="flex gap-2 items-center">
          <button type="button" id="hs-clear-filters" class="hidden px-3 py-1 text-sm border-2 border-red-pats text-red-pats rounded cursor-pointer hover:bg-red-pats hover:text-white">Clear Filters</button>
          <label for="hs-sort" class="text-sm">Sort:</label>
          <select id="hs-sort" class="border rounded px-2 py-1">
            <option value="newest">Newest</option>
            <option value="oldest">Oldest</option>
            <option value="longest">Longest</option>
          </select>
        </div>
      </div>

      <div class="mx-auto p-2 patriots text-xl w-fit" id="hs-result-summary">Displaying 0 - 0 of 0 plays</div>

      {# Cards use the same w-1/2 md:w-1/3 lg:w-1/4 self-sizing as dynasty_tw:highlight-card
         elsewhere on the site, so this is a flex-wrap container, not a grid. #}
      <div id="hs-results" class="flex flex-wrap justify-around"></div>

      <div id="hs-pagination" class="flex justify-center gap-2 mt-6 p-4"></div>
    </div>
  </div>
</div>
