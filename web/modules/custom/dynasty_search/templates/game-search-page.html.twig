{#
/**
 * @file
 * Game Search page shell. All data is loaded client-side from
 * /dynasty/search/games by js/game-search.js — this template only provides
 * the filter controls and empty result containers.
 */
#}

{% set opponent_filter %}
  <label for="gs-filter-opponent" class="block text-sm mb-1">Opponent</label>
  <select id="gs-filter-opponent" multiple class="text-blue-pats select2-widget w-full" data-select2-config='{"placeholder":"- Select Team -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set coach_filter %}
  <label for="gs-filter-coach" class="block text-sm mb-1">Opposing Coach</label>
  <select id="gs-filter-coach" multiple class="select2-widget w-full" data-select2-config='{"placeholder":"- Select Coach -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set week_filter %}
  <label for="gs-filter-week" class="block text-sm mb-1">Week</label>
  <select id="gs-filter-week" multiple class="select2-widget w-full" data-select2-config='{"placeholder":"- Select a Week -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set season_filter %}
  <label for="gs-filter-season" class="block text-sm mb-1">Season</label>
  <select id="gs-filter-season" multiple class="select2-widget w-full" data-select2-config='{"placeholder":"- Select Season(s) -","allowClear":true,"width":"100%"}'></select>
{% endset %}

{% set result_filter %}
  <div class="text-sm mb-1">Result</div>
  <div class="gs-toggle-group flex gap-1" data-filter="result">
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="">All</button>
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="Win">Win</button>
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="Loss">Loss</button>
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="Tie">Tie</button>
  </div>
{% endset %}

{% set home_away_filter %}
  <div class="text-sm mb-1">Home/Away</div>
  <div class="gs-toggle-group flex gap-1" data-filter="home_away">
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="">All</button>
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="Home">Home</button>
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="Away">Away</button>
  </div>
{% endset %}

{% set bye_filter %}
  <div class="text-sm mb-1">Game is After a Bye</div>
  <div class="gs-toggle-group flex gap-1" data-filter="after_bye">
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="">All</button>
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="1">Yes</button>
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="0">No</button>
  </div>
{% endset %}

{% set ot_filter %}
  <div class="text-sm mb-1">Overtime Game</div>
  <div class="gs-toggle-group flex gap-1" data-filter="ot">
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="">All</button>
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="1">Yes</button>
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="0">No</button>
  </div>
{% endset %}

{% set playoff_filter %}
  <div class="text-sm mb-1">Playoff Game</div>
  <div class="gs-toggle-group flex gap-1" data-filter="playoff_game">
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="">All</button>
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="1">Yes</button>
    <button type="button" class="gs-toggle px-3 py-1 border rounded" data-value="0">No</button>
  </div>
{% endset %}

{% set score_range_filters %}
  <div class="mb-8">
    <div class="text-sm mb-4">Patriots Score</div>
    <div id="gs-slider-patriots-score" class="bef-slider"></div>
    <div class="slider-min-max-labels"><span class="min-label"></span><span class="max-label"></span></div>
  </div>
  <div class="mb-8">
    <div class="text-sm mb-4">Opponent Score</div>
    <div id="gs-slider-opponent-score" class="bef-slider"></div>
    <div class="slider-min-max-labels"><span class="min-label"></span><span class="max-label"></span></div>
  </div>
  <div class="mb-4">
    <div class="text-sm mb-4">Score Differential</div>
    <div id="gs-slider-score-differential" class="bef-slider"></div>
    <div class="slider-min-max-labels"><span class="min-label"></span><span class="max-label"></span></div>
  </div>
{% endset %}

{% set reset_filter %}
  <button type="button" id="gs-reset" class="w-full px-3 py-2 bg-red-pats text-white rounded">Reset Search</button>
{% endset %}

{#
  A single copy of the filter panel, shown as an always-visible sidebar on
  desktop and a collapsible "Filters ▼" drawer on mobile (same look as
  dynasty_tw:facets-sidebar, but rendered once — that component renders its
  `facets` twice, once per breakpoint, which would duplicate these hard-coded
  filter element ids).
#}
<div id="game-search-app" class="mx-auto">
  <div class="flex flex-wrap md:!flex-nowrap gap-4">
    <div class="md:!w-1/4">
      <h2 id="gs-filter-toggle" class="md:!hidden bg-gray-500 font-light p-2 text-center text-white text-xl uppercase" style="cursor: pointer">Filters &#9660;</h2>
      <div id="gs-filters-panel" class="hidden md:!block bg-blue-pats text-gray-300 border border-gray-400 p-2 shadow-lg divide-y">
        <div class="p-3">{{ opponent_filter }}</div>
        <div class="p-3">{{ coach_filter }}</div>
        <div class="p-3">{{ week_filter }}</div>
        <div class="p-3">{{ season_filter }}</div>
        <div class="p-3">{{ result_filter }}</div>
        <div class="p-3">{{ home_away_filter }}</div>
        <div class="p-3">{{ bye_filter }}</div>
        <div class="p-3">{{ ot_filter }}</div>
        <div class="p-3">{{ playoff_filter }}</div>
        <div class="p-3">{{ score_range_filters }}</div>
        <div class="p-3">{{ reset_filter }}</div>
      </div>
    </div>

    <div class="w-full md:!w-3/4 min-w-0">
      <div id="gs-summary" class="px-4 py-5 text-lg">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2>Displaying <span class="text-red-pats"><span id="gs-count">0</span> games</span></h2>
          <button type="button" id="gs-clear-filters" class="hidden px-3 py-1 text-sm border-2 border-red-pats text-red-pats rounded cursor-pointer hover:bg-red-pats hover:text-white">Clear Filters</button>
        </div>
        <div id="gs-active-filters" class="flex flex-wrap gap-2 mt-2"></div>
      </div>

      <div id="gs-record" class="flex items-center justify-evenly">
        <div class="patriots p-2 w-1/3 md:!w-1/4">
          <div class="text-2xl text-center hidden md:!block">Patriots Record</div>
          <div class="text-2xl text-center block md:!hidden">Record</div>
          <div class="text-xl md:!text-3xl text-center" id="gs-winloss">0 - 0</div>
        </div>
        <div class="patriots p-2 w-1/3 md:!w-1/4">
          <div class="text-2xl text-center hidden md:!block">Win Percentage</div>
          <div class="text-2xl text-center block md:!hidden">Win %</div>
          <div class="text-xl md:!text-3xl text-center" id="gs-winpct">0</div>
        </div>
        <div class="patriots p-2 w-1/3 md:!w-1/4">
          <div class="text-2xl text-center hidden md:!block">Average Score</div>
          <div class="text-2xl text-center block md:!hidden">Score</div>
          <div class="text-xl md:!text-3xl text-center" id="gs-avgscore">0 - 0</div>
        </div>
      </div>

      <div id="gs-qb-stats" class="px-14 py-5"></div>

      <div class="overflow-x-auto">
        <div class="min-w-full inline-block align-middle">
          <div class="overflow-hidden">
            <table class="table w-full">
              <thead class="bg-blue-pats text-white">
                <tr>
                  <th data-field="title">Game</th>
                  <th data-field="patriots_score" data-sortable="1">Pats</th>
                  <th data-field="opponent_score" data-sortable="1">Opp</th>
                  <th data-field="opponent" data-sortable="1">Opponent</th>
                  <th data-field="opp_coach" data-sortable="1">Opposing Coach</th>
                  <th data-field="result" data-sortable="1">Result</th>
                  <th data-field="home_away" data-sortable="1">Home/Away</th>
                  <th data-field="month" data-sortable="1">Month</th>
                  <th data-field="weekday" data-sortable="1">Weekday</th>
                  <th data-field="starting_qb">QB</th>
                  <th data-field="brady_attempts" data-sortable="1">Att</th>
                  <th data-field="brady_completions" data-sortable="1">CMP</th>
                  <th data-field="brady_yards" data-sortable="1">YD</th>
                  <th data-field="brady_tds" data-sortable="1">TD</th>
                  <th data-field="brady_ints" data-sortable="1">INT</th>
                  <th data-field="passer_rating" data-sortable="1">QBR</th>
                </tr>
              </thead>
              <tbody id="gs-tbody"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
