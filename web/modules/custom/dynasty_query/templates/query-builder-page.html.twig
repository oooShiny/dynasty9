{#
/**
 * @file
 * Query Builder page shell. All data is loaded client-side from
 * /dynasty/query/schema, /dynasty/query/options, and /dynasty/query/run by
 * js/query-builder.js — this template only provides the control panel and
 * an empty results table.
 */
#}
<div id="query-builder-app" class="mx-auto">
  <div class="flex flex-wrap md:!flex-nowrap gap-4">
    <div class="w-full md:!w-1/3">
      <div class="bg-blue-pats text-gray-300 border border-gray-400 p-4 shadow-lg space-y-4">
        <div>
          <label for="qb-fact" class="block text-sm mb-1 font-semibold">Data Set</label>
          <select id="qb-fact" class="w-full text-black p-2 rounded"></select>
        </div>

        <div>
          <div class="text-sm mb-1 font-semibold">Group By</div>
          <div id="qb-dimensions" class="space-y-1 max-h-40 overflow-y-auto bg-white text-black p-2 rounded"></div>
        </div>

        <div>
          <div class="text-sm mb-1 font-semibold">Measures</div>
          <div id="qb-measures" class="space-y-1 max-h-40 overflow-y-auto bg-white text-black p-2 rounded"></div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <div class="text-sm font-semibold">Filters</div>
            <button type="button" id="qb-add-filter" class="text-xs px-2 py-1 border border-gray-300 rounded hover:bg-white hover:text-black">+ Add Filter</button>
          </div>
          <div id="qb-filters" class="space-y-3"></div>
        </div>

        <div class="flex gap-2">
          <div class="flex-1">
            <label for="qb-sort" class="block text-sm mb-1 font-semibold">Sort By</label>
            <select id="qb-sort" class="w-full text-black p-2 rounded"></select>
          </div>
          <div>
            <label for="qb-sort-dir" class="block text-sm mb-1 font-semibold">Dir</label>
            <select id="qb-sort-dir" class="text-black p-2 rounded">
              <option value="desc">Desc</option>
              <option value="asc">Asc</option>
            </select>
          </div>
        </div>

        <div>
          <label for="qb-limit" class="block text-sm mb-1 font-semibold">Limit</label>
          <input type="number" id="qb-limit" value="50" min="1" max="500" class="w-full text-black p-2 rounded">
        </div>

        <button type="button" id="qb-run" class="w-full px-3 py-2 bg-red-pats text-white rounded font-semibold">Run Query</button>
      </div>
    </div>

    <div class="w-full md:!w-2/3 min-w-0">
      <div id="qb-error" class="hidden bg-red-100 text-red-800 border border-red-400 p-3 rounded mb-4"></div>
      <div class="overflow-x-auto">
        <div class="min-w-full inline-block align-middle">
          <div class="overflow-hidden">
            <table class="table w-full">
              <thead class="bg-blue-pats text-white">
                <tr id="qb-thead-row"></tr>
              </thead>
              <tbody id="qb-tbody">
                <tr><td class="p-5 text-center">Choose a data set, pick some Group By fields and/or Measures, then click Run Query.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
