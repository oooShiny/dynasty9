<?php

/**
 * @file
 * Install, update and uninstall functions for the dynasty_plays module.
 */

use Drupal\Core\Field\BaseFieldDefinition;

/**
 * Add new fields to the Play entity.
 */
function dynasty_plays_update_9002() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  $entity_type_id = 'play';
  $entity_type = $entity_type_manager->getDefinition($entity_type_id);

  // Define all the fields that need to be added.
  $fields_to_add = [];

  // Play Description field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('play_description', $entity_type_id)) {
    $fields_to_add['play_description'] = BaseFieldDefinition::create('text_long')
      ->setLabel(t('Play Description'))
      ->setDescription(t('A description of the play.'))
      ->setTranslatable(TRUE)
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'text_default',
        'weight' => 0,
      ])
      ->setDisplayOptions('form', [
        'type' => 'text_textarea',
        'weight' => 0,
        'settings' => [
          'rows' => 5,
        ],
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Play Highlight field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('play_highlight', $entity_type_id)) {
    $fields_to_add['play_highlight'] = BaseFieldDefinition::create('entity_reference')
      ->setLabel(t('Play Highlight'))
      ->setDescription(t('Reference to a Highlight node.'))
      ->setSetting('target_type', 'node')
      ->setSetting('handler', 'default:node')
      ->setSetting('handler_settings', [
        'target_bundles' => [
          'highlight' => 'highlight',
        ],
      ])
      ->setTranslatable(TRUE)
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'entity_reference_label',
        'weight' => 1,
        'settings' => [
          'link' => TRUE,
        ],
      ])
      ->setDisplayOptions('form', [
        'type' => 'entity_reference_autocomplete',
        'weight' => 1,
        'settings' => [
          'match_operator' => 'CONTAINS',
          'size' => '60',
          'autocomplete_type' => 'tags',
          'placeholder' => '',
        ],
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Play Game field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('play_game', $entity_type_id)) {
    $fields_to_add['play_game'] = BaseFieldDefinition::create('entity_reference')
      ->setLabel(t('Play Game'))
      ->setDescription(t('Reference to a Game node.'))
      ->setSetting('target_type', 'node')
      ->setSetting('handler', 'default:node')
      ->setSetting('handler_settings', [
        'target_bundles' => [
          'game' => 'game',
        ],
      ])
      ->setTranslatable(TRUE)
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'entity_reference_label',
        'weight' => 2,
        'settings' => [
          'link' => TRUE,
        ],
      ])
      ->setDisplayOptions('form', [
        'type' => 'entity_reference_autocomplete',
        'weight' => 2,
        'settings' => [
          'match_operator' => 'CONTAINS',
          'size' => '60',
          'autocomplete_type' => 'tags',
          'placeholder' => '',
        ],
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Scoring Team field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('scoring_team', $entity_type_id)) {
    $fields_to_add['scoring_team'] = BaseFieldDefinition::create('string')
      ->setLabel(t('Scoring Team'))
      ->setDescription(t('The team that scored on this play.'))
      ->setSettings([
        'max_length' => 50,
        'text_processing' => 0,
      ])
      ->setDefaultValue('')
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'string',
        'weight' => 3,
      ])
      ->setDisplayOptions('form', [
        'type' => 'string_textfield',
        'weight' => 3,
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Quarter field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('quarter', $entity_type_id)) {
    $fields_to_add['quarter'] = BaseFieldDefinition::create('list_integer')
      ->setLabel(t('Quarter'))
      ->setDescription(t('The quarter in which the play occurred.'))
      ->setSettings([
        'allowed_values' => [
          1 => '1st Quarter',
          2 => '2nd Quarter',
          3 => '3rd Quarter',
          4 => '4th Quarter',
          5 => 'Overtime',
        ],
      ])
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'list_default',
        'weight' => 4,
      ])
      ->setDisplayOptions('form', [
        'type' => 'options_select',
        'weight' => 4,
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Minutes field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('minutes', $entity_type_id)) {
    $fields_to_add['minutes'] = BaseFieldDefinition::create('integer')
      ->setLabel(t('Minutes'))
      ->setDescription(t('Minutes remaining in the quarter (0-15).'))
      ->setSettings([
        'min' => 0,
        'max' => 15,
      ])
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'number_integer',
        'weight' => 5,
      ])
      ->setDisplayOptions('form', [
        'type' => 'number',
        'weight' => 5,
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Seconds field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('seconds', $entity_type_id)) {
    $fields_to_add['seconds'] = BaseFieldDefinition::create('integer')
      ->setLabel(t('Seconds'))
      ->setDescription(t('Seconds remaining in the quarter (0-59).'))
      ->setSettings([
        'min' => 0,
        'max' => 59,
      ])
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'number_integer',
        'weight' => 6,
      ])
      ->setDisplayOptions('form', [
        'type' => 'number',
        'weight' => 6,
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Distance field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('distance', $entity_type_id)) {
    $fields_to_add['distance'] = BaseFieldDefinition::create('integer')
      ->setLabel(t('Distance'))
      ->setDescription(t('Distance in yards (0-99).'))
      ->setSettings([
        'min' => 0,
        'max' => 99,
      ])
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'number_integer',
        'weight' => 7,
      ])
      ->setDisplayOptions('form', [
        'type' => 'number',
        'weight' => 7,
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Scoring Play field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('scoring_play', $entity_type_id)) {
    $fields_to_add['scoring_play'] = BaseFieldDefinition::create('boolean')
      ->setLabel(t('Scoring Play'))
      ->setDescription(t('Check if this play resulted in a score.'))
      ->setDefaultValue(TRUE)
      ->setDisplayOptions('view', [
        'label' => 'inline',
        'type' => 'boolean',
        'weight' => 8,
        'settings' => [
          'format' => 'yes-no',
        ],
      ])
      ->setDisplayOptions('form', [
        'type' => 'boolean_checkbox',
        'weight' => 8,
        'settings' => [
          'display_label' => TRUE,
        ],
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Turnover field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('turnover', $entity_type_id)) {
    $fields_to_add['turnover'] = BaseFieldDefinition::create('boolean')
      ->setLabel(t('Turnover'))
      ->setDescription(t('Check if this play resulted in a turnover.'))
      ->setDefaultValue(FALSE)
      ->setDisplayOptions('view', [
        'label' => 'inline',
        'type' => 'boolean',
        'weight' => 9,
        'settings' => [
          'format' => 'yes-no',
        ],
      ])
      ->setDisplayOptions('form', [
        'type' => 'boolean_checkbox',
        'weight' => 9,
        'settings' => [
          'display_label' => TRUE,
        ],
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Install all new field definitions.
  foreach ($fields_to_add as $field_name => $field_definition) {
    $entity_definition_update_manager->installFieldStorageDefinition(
      $field_name,
      $entity_type_id,
      'dynasty_plays',
      $field_definition
    );
  }

  $message = t('Added @count new fields to the Play entity.', [
    '@count' => count($fields_to_add),
  ]);

  return $message;
}

/**
 * Install the new Player Game Stat entity type.
 */
function dynasty_plays_update_9003() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  // Clear the definitions cache so the new entity type annotation is picked
  // up before we try to install it.
  $entity_type_manager->clearCachedDefinitions();

  $entity_type = \Drupal::entityTypeManager()->getDefinition('player_game_stat');
  $entity_definition_update_manager->installEntityType($entity_type);

  return t('Installed the Player Game Stat entity type.');
}

/**
 * Install the new Play-by-Play entity type.
 */
function dynasty_plays_update_9004() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  $entity_type_manager->clearCachedDefinitions();

  $entity_type = \Drupal::entityTypeManager()->getDefinition('pbp_play');
  $entity_definition_update_manager->installEntityType($entity_type);

  return t('Installed the Play-by-Play entity type.');
}

/**
 * Add the Player reference field to the Play entity.
 */
function dynasty_plays_update_9005() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  $entity_type_id = 'play';
  $entity_type = $entity_type_manager->getDefinition($entity_type_id);

  $fields_to_add = [];

  // Player(s) field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('play_player', $entity_type_id)) {
    $fields_to_add['play_player'] = BaseFieldDefinition::create('entity_reference')
      ->setLabel(t('Player(s)'))
      ->setDescription(t('The player(s) directly involved in this play.'))
      ->setSetting('target_type', 'node')
      ->setSetting('handler', 'default:node')
      ->setSetting('handler_settings', [
        'target_bundles' => [
          'player' => 'player',
        ],
      ])
      ->setCardinality(\Drupal\Core\Field\FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED)
      ->setTranslatable(TRUE)
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'entity_reference_label',
        'weight' => 10,
        'settings' => [
          'link' => TRUE,
        ],
      ])
      ->setDisplayOptions('form', [
        'type' => 'entity_reference_autocomplete',
        'weight' => 10,
        'settings' => [
          'match_operator' => 'CONTAINS',
          'size' => '60',
          'autocomplete_type' => 'tags',
          'placeholder' => '',
        ],
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  foreach ($fields_to_add as $field_name => $field_definition) {
    $entity_definition_update_manager->installFieldStorageDefinition(
      $field_name,
      $entity_type_id,
      'dynasty_plays',
      $field_definition
    );
  }

  return t('Added @count new field(s) to the Play entity.', [
    '@count' => count($fields_to_add),
  ]);
}

/**
 * Add the best-effort Player match field to the Play-by-Play entity.
 */
function dynasty_plays_update_9006() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  $entity_type_id = 'pbp_play';
  $entity_type = $entity_type_manager->getDefinition($entity_type_id);

  $fields_to_add = [];

  // Player field. Deliberately single-value (no ->setCardinality()
  // override) and NOT translatable, so it lands as a plain `pbp_player`
  // column on the `pbp_play` base table -- same as `pbp_game` already does
  // -- so SearchDataController::playByPlay()'s raw SQL ->fields('p', [...])
  // select can read it directly with no join or per-row Entity API load.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('pbp_player', $entity_type_id)) {
    $fields_to_add['pbp_player'] = BaseFieldDefinition::create('entity_reference')
      ->setLabel(t('Player'))
      ->setDescription(t('Best-effort match of the primary player in this play, parsed from the detail text. Empty when no single confident match was found.'))
      ->setSetting('target_type', 'node')
      ->setSetting('handler', 'default:node')
      ->setSetting('handler_settings', [
        'target_bundles' => [
          'player' => 'player',
        ],
      ])
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'entity_reference_label',
        'weight' => 13,
        'settings' => [
          'link' => TRUE,
        ],
      ])
      ->setDisplayOptions('form', [
        'type' => 'entity_reference_autocomplete',
        'weight' => 13,
        'settings' => [
          'match_operator' => 'CONTAINS',
          'size' => '60',
          'autocomplete_type' => 'tags',
          'placeholder' => '',
        ],
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  foreach ($fields_to_add as $field_name => $field_definition) {
    $entity_definition_update_manager->installFieldStorageDefinition(
      $field_name,
      $entity_type_id,
      'dynasty_plays',
      $field_definition
    );
  }

  return t('Added @count new field(s) to the Play-by-Play entity.', [
    '@count' => count($fields_to_add),
  ]);
}

/**
 * Add scoring-play, scoring-team, and highlight fields to the Play-by-Play
 * entity, so it can take over the retired Play entity's role.
 */
function dynasty_plays_update_9007() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  $entity_type_id = 'pbp_play';
  $entity_type = $entity_type_manager->getDefinition($entity_type_id);

  $fields_to_add = [];

  // Scoring Play field. Computed at import time from a running-score delta
  // against the previous row in the same game.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('pbp_scoring_play', $entity_type_id)) {
    $fields_to_add['pbp_scoring_play'] = BaseFieldDefinition::create('boolean')
      ->setLabel(t('Scoring Play'))
      ->setDescription(t('Whether the running score changed on this play, relative to the previous play in the same game.'))
      ->setDefaultValue(FALSE)
      ->setDisplayOptions('view', [
        'label' => 'inline',
        'type' => 'boolean',
        'weight' => 14,
        'settings' => [
          'format' => 'yes-no',
        ],
      ])
      ->setDisplayOptions('form', [
        'type' => 'boolean_checkbox',
        'weight' => 14,
        'settings' => [
          'display_label' => TRUE,
        ],
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Scoring Team field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('pbp_scoring_team', $entity_type_id)) {
    $fields_to_add['pbp_scoring_team'] = BaseFieldDefinition::create('string')
      ->setLabel(t('Scoring Team'))
      ->setDescription(t('The team that scored on this play, if any.'))
      ->setSettings([
        'max_length' => 50,
        'text_processing' => 0,
      ])
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'string',
        'weight' => 15,
      ])
      ->setDisplayOptions('form', [
        'type' => 'string_textfield',
        'weight' => 15,
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Highlight field. Deliberately single-value (no ->setCardinality()
  // override) and NOT translatable, so it lands as a plain `pbp_highlight`
  // column on the `pbp_play` base table -- same as `pbp_player` -- so
  // SearchDataController::playByPlay()'s raw SQL ->fields('p', [...])
  // select can read it directly with no join or per-row Entity API load.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('pbp_highlight', $entity_type_id)) {
    $fields_to_add['pbp_highlight'] = BaseFieldDefinition::create('entity_reference')
      ->setLabel(t('Highlight'))
      ->setDescription(t('The Highlight video for this play, if one has been manually linked.'))
      ->setSetting('target_type', 'node')
      ->setSetting('handler', 'default:node')
      ->setSetting('handler_settings', [
        'target_bundles' => [
          'highlight' => 'highlight',
        ],
      ])
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'entity_reference_label',
        'weight' => 16,
        'settings' => [
          'link' => TRUE,
        ],
      ])
      ->setDisplayOptions('form', [
        'type' => 'entity_reference_autocomplete',
        'weight' => 16,
        'settings' => [
          'match_operator' => 'CONTAINS',
          'size' => '60',
          'autocomplete_type' => 'tags',
          'placeholder' => '',
        ],
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  foreach ($fields_to_add as $field_name => $field_definition) {
    $entity_definition_update_manager->installFieldStorageDefinition(
      $field_name,
      $entity_type_id,
      'dynasty_plays',
      $field_definition
    );
  }

  return t('Added @count new field(s) to the Play-by-Play entity.', [
    '@count' => count($fields_to_add),
  ]);
}

/**
 * Uninstall the retired Play entity type.
 *
 * pbp_play now covers everything play did: scoring plays are derivable
 * from pbp_play's own running-score data (pbp_scoring_play/
 * pbp_scoring_team, added in dynasty_plays_update_9007()), and its two
 * real highlight links were migrated onto the matching pbp_play rows.
 * Every config/code reference to the `play` entity type (views,
 * displays, permissions, routing, PHP classes, theming) was removed in
 * prior commits, so nothing should still depend on it by the time this
 * runs.
 */
function dynasty_plays_update_9008() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  $entity_type_manager->clearCachedDefinitions();

  $entity_type_id = 'play';
  $storage = $entity_type_manager->getStorage($entity_type_id);
  $ids = $storage->getQuery()->accessCheck(FALSE)->execute();
  $deleted_count = count($ids);
  if ($ids) {
    foreach (array_chunk($ids, 500) as $slice) {
      $storage->delete($storage->loadMultiple($slice));
    }
  }

  $entity_type = $entity_definition_update_manager->getEntityType($entity_type_id);
  if ($entity_type) {
    $entity_definition_update_manager->uninstallEntityType($entity_type);
  }

  return t('Deleted @count Play entities and uninstalled the Play entity type.', [
    '@count' => $deleted_count,
  ]);
}

/**
 * Add play_type, two_point_attempt, and per-role player fields to the
 * Play-by-Play entity.
 *
 * Populated at import time from columns the source CSVs didn't carry
 * before: nflfastR's own play_type + role columns for 2000+ (previously
 * discarded by nfldata.org's extract-patriots-pbp.py), and
 * enrich-legacy-pbp.py's regex-derived equivalents for pre-2000 (see that
 * script, and ne_legacy_parser.py's classify(), in the nfldata.org
 * sibling project). See PbpPlay::baseFieldDefinitions() for the full
 * rationale, including why each player-role field is deliberately
 * single-value/non-translatable.
 */
function dynasty_plays_update_9009() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  $entity_type_id = 'pbp_play';
  $entity_type = $entity_type_manager->getDefinition($entity_type_id);

  $fields_to_add = [];

  // Play Type field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('pbp_play_type', $entity_type_id)) {
    $fields_to_add['pbp_play_type'] = BaseFieldDefinition::create('list_string')
      ->setLabel(t('Play Type'))
      ->setDescription(t('The canonical play type for this play.'))
      ->setSettings([
        'allowed_values' => [
          'pass' => t('Pass'),
          'run' => t('Run'),
          'punt' => t('Punt'),
          'kickoff' => t('Kickoff'),
          'field_goal' => t('Field Goal'),
          'extra_point' => t('Extra Point'),
          'qb_kneel' => t('QB Kneel'),
          'qb_spike' => t('QB Spike'),
          'no_play' => t('No Play'),
          'penalty' => t('Penalty'),
          'other' => t('Other'),
        ],
      ])
      ->setDisplayOptions('view', [
        'label' => 'above',
        'type' => 'list_default',
        'weight' => 17,
      ])
      ->setDisplayOptions('form', [
        'type' => 'options_select',
        'weight' => 17,
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Two Point Attempt field.
  if (!$entity_definition_update_manager->getFieldStorageDefinition('pbp_two_point_attempt', $entity_type_id)) {
    $fields_to_add['pbp_two_point_attempt'] = BaseFieldDefinition::create('boolean')
      ->setLabel(t('Two Point Attempt'))
      ->setDescription(t('Whether this play was a two-point conversion attempt.'))
      ->setDefaultValue(FALSE)
      ->setDisplayOptions('view', [
        'label' => 'inline',
        'type' => 'boolean',
        'weight' => 18,
        'settings' => [
          'format' => 'yes-no',
        ],
      ])
      ->setDisplayOptions('form', [
        'type' => 'boolean_checkbox',
        'weight' => 18,
        'settings' => [
          'display_label' => TRUE,
        ],
      ])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
  }

  // Per-role player fields. Each single-value/non-translatable, same
  // reasoning as pbp_player -- see PbpPlay::baseFieldDefinitions().
  $weight = 19;
  foreach ([
    'pbp_passer' => [t('Passer'), t('The player who threw the pass, on a pass play.')],
    'pbp_rusher' => [t('Rusher'), t('The ball carrier, on a run play.')],
    'pbp_receiver' => [t('Receiver'), t('The intended or actual receiver, on a pass play.')],
    'pbp_interceptor' => [t('Interceptor'), t('The player who intercepted the pass, if any.')],
    'pbp_sacker' => [t('Sacker'), t('The defender credited with the sack, if any.')],
    'pbp_punter' => [t('Punter'), t('The punter, on a punt play.')],
    'pbp_kicker' => [t('Kicker'), t('The kicker, on a kickoff/field goal/extra point play.')],
    'pbp_returner' => [t('Returner'), t('The player who returned the kick/punt, if any.')],
    'pbp_blocker' => [t('Blocker'), t('The defender who blocked the kick/punt, if any.')],
    'pbp_tackler_1' => [t('Tackler 1'), t('The first player credited with the tackle, if any.')],
    'pbp_tackler_2' => [t('Tackler 2'), t('The second player credited with the tackle (an assist), if any.')],
    'pbp_forced_fumble_player' => [t('Forced Fumble By'), t('The defender who forced a fumble, if any.')],
    'pbp_fumble_recovery_player' => [t('Fumble Recovered By'), t('The player who recovered a fumble, if any.')],
    'pbp_penalized_player' => [t('Penalized Player'), t('The player a penalty was called on, if the source names one rather than just a team.')],
  ] as $field_name => [$label, $description]) {
    if (!$entity_definition_update_manager->getFieldStorageDefinition($field_name, $entity_type_id)) {
      $fields_to_add[$field_name] = BaseFieldDefinition::create('entity_reference')
        ->setLabel($label)
        ->setDescription($description)
        ->setSetting('target_type', 'node')
        ->setSetting('handler', 'default:node')
        ->setSetting('handler_settings', [
          'target_bundles' => [
            'player' => 'player',
          ],
        ])
        ->setDisplayOptions('view', [
          'label' => 'above',
          'type' => 'entity_reference_label',
          'weight' => $weight,
          'settings' => [
            'link' => TRUE,
          ],
        ])
        ->setDisplayOptions('form', [
          'type' => 'entity_reference_autocomplete',
          'weight' => $weight,
          'settings' => [
            'match_operator' => 'CONTAINS',
            'size' => '60',
            'autocomplete_type' => 'tags',
            'placeholder' => '',
          ],
        ])
        ->setDisplayConfigurable('form', TRUE)
        ->setDisplayConfigurable('view', TRUE);
    }
    $weight++;
  }

  foreach ($fields_to_add as $field_name => $field_definition) {
    $entity_definition_update_manager->installFieldStorageDefinition(
      $field_name,
      $entity_type_id,
      'dynasty_plays',
      $field_definition
    );
  }

  return t('Added @count new field(s) to the Play-by-Play entity.', [
    '@count' => count($fields_to_add),
  ]);
}
