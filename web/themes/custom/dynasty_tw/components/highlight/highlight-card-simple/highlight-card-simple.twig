<article class="bg-blue-pats text-white">
  <div class="max-w-75">
    {{ video }}
    <div class="p-2">
      <div class="flex gap-2 my-2">
        <img src="/themes/custom/dynasty_tw/icons/strategy.png" class="aspect-square h-5" alt="">
        <h4 class="truncate text-sm">
          <a href="{{ url }}" rel="bookmark" class="text-sm">{{ label }}</a>
        </h4>
      </div>
      <div class="flex gap-2 my-2">
        <img src="/themes/custom/dynasty_tw/icons/stadium.png" class="aspect-square h-5" alt="">
        <h4 class="truncate text-sm">{{ game }}</h4>
      </div>
    </div>
  </div>
</article>
