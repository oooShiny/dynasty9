<article class="mt-10">
  {# White row — subtitle, duration, body #}
  <div class="py-10">
    {% if subtitle|render %}
      <h2 class="uppercase font-light text-center text-xl">{{ subtitle }}</h2>
    {% endif %}
    <h3 class="uppercase font-light text-center text-l">({{ duration }})</h3>
    <div class="m-auto pt-10 w-2/3">
      {{ body }}
    </div>
  </div>

  {# Blue row — Acast embed + platform badges #}
  <div class="bg-blue-pats text-white py-10">
    <h2 class="uppercase font-light text-center text-xl">Listen Now</h2>
    <div class="w-flex h-40 m-auto mb-5 pt-10 w-2/3">
      <iframe allow="autoplay"
              src="https://embed.acast.com/5d23d6cdd5ef084d07ef59b9/{{ mp3 }}"
              frameBorder="0"
              width="100%">
      </iframe>
    </div>
    <ul class="flex flex-wrap justify-evenly py-10">
      <li class="pt-4 w-56 gap-1">
        <a href="https://itunes.apple.com/us/podcast/id1497577531?mt=2" id="pod-apple-button">
          <img alt="Listen on Apple Podcasts" height="81" src="/themes/custom/dynasty_tw/icons/podcast-badges/applepodcasts-badge.svg" width="300">
        </a>
      </li>
      <li class="pt-4 w-56 gap-1">
        <a href="https://pca.st/pa8slg4f" id="pod-pocketcasts-button">
          <img alt="Listen on Pocket Casts" height="81" src="/themes/custom/dynasty_tw/icons/podcast-badges/pocketcasts-badge.svg" width="300">
        </a>
      </li>
      <li class="pt-4 w-56 gap-1">
        <a href="https://podcasts.google.com/?feed=aHR0cHM6Ly9mZWVkcy5hY2FzdC5jb20vcHVibGljL3Nob3dzLzVkMjNkNmNkZDVlZjA4NGQwN2VmNTliOQ" id="pod-google-button">
          <img alt="Listen on Google Podcasts" height="81" src="/themes/custom/dynasty_tw/icons/podcast-badges/googlepodcasts-badge.svg" width="300">
        </a>
      </li>
      <li class="pt-4 w-56 gap-1">
        <a href="https://open.spotify.com/show/7pA5XFa7J0mmby0vTCosOu" id="pod-spotify-button">
          <img alt="Listen on Spotify" height="81" src="/themes/custom/dynasty_tw/icons/podcast-badges/spotify-badge.svg" width="300">
        </a>
      </li>
      <li class="pt-4 w-56 gap-1">
        <a href="https://www.stitcher.com/podcast/patriots-dynasty-podcast" id="pod-stitcher-button">
          <img alt="Listen on Stitcher" height="81" src="/themes/custom/dynasty_tw/icons/podcast-badges/stitcher-badge.svg" width="300">
        </a>
      </li>
      <li class="pt-4 w-56 gap-1">
        <a href="https://www.youtube.com/channel/UCyVCkL2azPXZZruRHgs9Kqw" id="pod-youtube-button">
          <img alt="Listen on Youtube" height="81" src="/themes/custom/dynasty_tw/icons/podcast-badges/youtube-badge.svg" width="300">
        </a>
      </li>
    </ul>
  </div>

  {# Game info — conditional #}
  {% if game|render %}
    <div class="py-10">
      <h2 class="uppercase font-light text-center text-xl">Game Info</h2>
      {{ game }}
    </div>
  {% endif %}

  {# Gray row — transcript (conditional) #}
  {% if transcript|render %}
    <div class="bg-gray-400 py-10">
      <h2 class="uppercase font-light text-center text-xl">Transcript</h2>
      <div class="m-auto pt-10 w-2/3">
        {{ transcript }}
      </div>
    </div>
  {% endif %}

  {# Download chart — Highcharts spline #}
  <div class="py-10">
    {{ total_downloads }}
    <div id="container" style="min-width: 310px; height: 400px; margin: 0 auto"></div>
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/export-data.js"></script>
    <script type="application/javascript">
      Highcharts.setOptions({
        colors: ['#053c65', '#c41334']
      });
      Highcharts.chart('container', {
        chart: {
          type: 'spline'
        },
        title: {
          text: 'Downloads per Month'
        },
        xAxis: {
          categories: [
            {% for year, month in downloads %}
              {% for data in month %}
                "{{ data.month_name }} {{ year }}",
              {% endfor %}
            {% endfor %}
          ],
          title: {
            text: 'Month'
          }
        },
        yAxis: {
          title: {
            text: 'Downloads'
          }
        },
        series: [{
          name: 'Downloads',
          data: [
            {% for year, month in downloads %}
              {% for data in month %}
               {{ data.dls }},
              {% endfor %}
            {% endfor %}
          ]
        }]
      });
    </script>
  </div>
</article>
