{% if items %}
  <nav class="flex justify-center pager p-6" role="navigation" aria-labelledby="{{ heading_id }}">
    <h4 id="{{ heading_id }}" class="visually-hidden">{{ 'Pagination'|t }}</h4>
    <ul class="pager__items js-pager__items flex gap-4">

      {% if items.first %}
        <a href="{{ items.first.href }}" title="{{ 'Go to first page'|t }}"{{ items.first.attributes|without('href', 'title') }}>
          <li class="pager__item pager__item--first min-w-10 text-center rounded p-2 hover:bg-blue-pats hover:text-white">
            <span class="visually-hidden">{{ 'First page'|t }}</span>
            <span aria-hidden="true">{{ items.first.text|default('« First'|t) }}</span>
          </li>
        </a>
      {% endif %}

      {% if items.previous %}
        <a href="{{ items.previous.href }}" title="{{ 'Go to previous page'|t }}" rel="prev"{{ items.previous.attributes|without('href', 'title', 'rel') }}>
          <li class="pager__item pager__item--previous min-w-10 text-center rounded p-2 hover:bg-blue-pats hover:text-white">
            <span class="visually-hidden">{{ 'Previous page'|t }}</span>
            <span aria-hidden="true">{{ items.previous.text|default('‹ Previous'|t) }}</span>
          </li>
        </a>
      {% endif %}

      {% if ellipses.previous %}
        <li class="pager__item pager__item--ellipsis min-w-10 text-center rounded p-2" role="presentation">&hellip;</li>
      {% endif %}

      {% for key, item in items.pages %}
        {% set title = current == key ? 'Current page'|t : 'Go to page @key'|t({'@key': key}) %}
        <a href="{{ item.href }}" title="{{ title }}"{{ item.attributes|without('href', 'title') }}>
          <li class="pager__item{{ current == key ? ' is-active bg-red-pats text-white' : '' }} min-w-10 text-center rounded p-2 hover:bg-blue-pats hover:text-white">
            <span class="visually-hidden">{{ current == key ? 'Current page'|t : 'Page'|t }}</span>
            {{- key -}}
          </li>
        </a>
      {% endfor %}

      {% if ellipses.next %}
        <li class="pager__item pager__item--ellipsis min-w-10 text-center rounded p-2" role="presentation">&hellip;</li>
      {% endif %}

      {% if items.next %}
        <a href="{{ items.next.href }}" title="{{ 'Go to next page'|t }}" rel="next"{{ items.next.attributes|without('href', 'title', 'rel') }}>
          <li class="pager__item pager__item--next min-w-10 text-center rounded p-2 hover:bg-blue-pats hover:text-white">
            <span class="visually-hidden">{{ 'Next page'|t }}</span>
            <span aria-hidden="true">{{ items.next.text|default('Next ›'|t) }}</span>
          </li>
        </a>
      {% endif %}

      {% if items.last %}
        <a href="{{ items.last.href }}" title="{{ 'Go to last page'|t }}"{{ items.last.attributes|without('href', 'title') }}>
          <li class="pager__item pager__item--last min-w-10 text-center rounded p-2 hover:bg-blue-pats hover:text-white">
            <span class="visually-hidden">{{ 'Last page'|t }}</span>
            <span aria-hidden="true">{{ items.last.text|default('Last »'|t) }}</span>
          </li>
        </a>
      {% endif %}

    </ul>
  </nav>
{% endif %}
