{#
/**
 * @file
 * Thin bridge → dynasty_tw:pager SDC.
 *
 * Available variables:
 *   - heading_id: Unique heading ID for the aria-labelledby link.
 *   - items: Pager item object (first, previous, pages, next, last).
 *   - current: Current page number (integer).
 *   - ellipses: Object with 'previous' and 'next' boolean flags.
 */
#}
{% if items %}
  {% include 'dynasty_tw:pager' with {
    heading_id: heading_id|default(''),
    items:      items,
    current:    current is not null ? current : 0,
    ellipses:   ellipses is not null ? ellipses : {previous: false, next: false},
  } only %}
{% endif %}
