{#
/**
 * @file
 * Thin bridge → dynasty_tw:filter-summary SDC.
 *
 * attributes.addClass() and data attribute must be rendered here so the SDC
 * receives a plain string rather than a Drupal Attribute object.
 *
 * Available variables:
 *   - attributes:      Drupal Attribute object (includes data-exposed-form-id).
 *   - summary:         Array of active filter items.
 *   - options:         Display options object.
 *   - exposed_form_id: ID of the associated exposed form.
 */
#}

{# Build the classes list matching the original template. #}
{% set classes = [
  'views-filters-summary',
  options.use_ajax ? 'views-filters-summary--use-ajax',
  'flex flex-wrap mt-4 gap-1',
]|filter(v => v)|join(' ') %}

{% set rendered_attrs %}{{ attributes.addClass(classes) }} data-exposed-form-id="{{ exposed_form_id }}"{% endset %}

{% include 'dynasty_tw:filter-summary' with {
  rendered_attrs: rendered_attrs,
  summary:        summary,
  options:        options,
} only %}
