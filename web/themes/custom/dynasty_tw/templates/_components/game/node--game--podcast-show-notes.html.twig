{#
/**
 * @file
 * Thin bridge → dynasty_tw:game-show-notes SDC.
 *
 * Slots that require URL extraction or drupal_view() calls are built here,
 * since those operations cannot happen inside the SDC after field rendering.
 */
#}

{# Game Videos — YouTube URL array-key access must happen pre-render. #}
{% set video_links %}
  {% if content.field_youtube_highlights|render %}
    <li>
      <img class="h-5 inline-block pr-2" src="/themes/custom/dynasty_tw/icons/youtube.png" alt="">
      <a href="{{ content.field_youtube_highlights[0]['#url'] }}" target="_blank" class="text-red-600 font-bold">Youtube Highlights</a>
    </li>
  {% endif %}
  {% if content.field_youtube_game_link|render %}
    <li>
      <img class="h-5 inline-block pr-2" src="/themes/custom/dynasty_tw/icons/youtube.png" alt="">
      <a href="{{ content.field_youtube_game_link|render|trim }}" class="text-red-600 font-bold">Youtube Game Video</a>
    </li>
  {% else %}
    <li>
      <img class="h-5 inline-block pr-2" src="/themes/custom/dynasty_tw/icons/patriotgames.png" alt="">
      <a href="https://patriots.games" target="_blank" class="text-blue-pats font-bold">Full Game</a>
    </li>
  {% endif %}
{% endset %}

{# Opponent season info card body #}
{% set opp_season_info %}
  {{ content.field_opponent_wikipedia }}
  {{ content.field_opponent_pfr }}
  <p>{{ opp_short }} finish the season {{ content.field_opponent_season_record }}</p>
  <p>{{ content.field_opponent_season_finish }}</p>
{% endset %}

{# Coaches card body #}
{% set opp_coaches %}
  <ul>
    <li>
      <strong>Head Coach:</strong> {{ content.field_opposing_coach }}
      <ul>
        <li>{{ content.field_pats_record_vs_coach }}</li>
        {% if content.field_opp_hc_notes|render %}
          <li>{{ content.field_opp_hc_notes }}</li>
        {% endif %}
      </ul>
    </li>
    <li><strong>OC:</strong> {{ content.field_opp_oc }}</li>
    <li><strong>DC:</strong> {{ content.field_opp_dc }}</li>
  </ul>
{% endset %}

{% include 'dynasty_tw:game-show-notes' with {
  url:      url,
  label:    label,
  vs:       vs,
  team_css: team_css,
  opp_name: opp_name,
  opp_short: opp_short,
  ot:       ot,
  season:   season,
  playoff:  playoff,
  node_id:  node.id(),

  prev_next:          prev_next_block,
  field_date:         content.field_date,
  patriots_score:     content.field_patriots_score,
  opponent_score:     content.field_opponent_score,
  field_pats_q1:      content.field_pats_q1,
  field_pats_q2:      content.field_pats_q2,
  field_pats_q3:      content.field_pats_q3,
  field_pats_q4:      content.field_pats_q4,
  field_pats_ot:      content.field_pats_ot,
  field_opp_q1:       content.field_opp_q1,
  field_opp_q2:       content.field_opp_q2,
  field_opp_q3:       content.field_opp_q3,
  field_opp_q4:       content.field_opp_q4,
  field_opp_ot:       content.field_opp_ot,
  video_links:        video_links,
  field_pfr_link:     content.field_pfr_link,
  field_drive_charts: content.field_drive_charts,
  scoring_plays:      drupal_view('scoring_plays', 'block_1', node.id()),
  opp_season_info:    opp_season_info,
  opp_team_ranks:     content.field_opponent_team_ranks,
  opp_coaches:        opp_coaches,
  opp_draft_picks:    content.field_opp_draft_picks,
  opp_pro_bowlers:    content.field_opp_pro_bowlers,
  opp_offense:        content.field_offensive_leaders,
  opp_defense:        content.field_defensive_leaders,
  field_game_summary: content.field_game_summary,
  game_highlights:    drupal_view('game_highlights', 'block_1', node.id()),
  field_other_media:  content.field_other_media,
} only %}
