{#
/**
 * @file
 * Thin bridge → dynasty_tw:game-teaser SDC.
 *
 * Variables from dynasty_tw_preprocess_node() (game bundle):
 *   - vs:        'vs' (home) or 'at' (away).
 *   - team_css:  Opponent team CSS class, e.g. 'kansas-city-chiefs'.
 *   - opp_name:  Full opponent name.
 *   - opp_short: Short opponent name (last word).
 *   - ot:        TRUE if overtime was played.
 */
#}
{% include 'dynasty_tw:game-teaser' with {
  url:             url,
  vs:              vs,
  team_css:        team_css,
  opp_name:        opp_name,
  opp_short:       opp_short,
  ot:              ot,
  patriots_score:  content.field_patriots_score,
  opponent_score:  content.field_opponent_score,
  date:            content.field_date,
  pats_q1:         content.field_pats_q1,
  pats_q2:         content.field_pats_q2,
  pats_q3:         content.field_pats_q3,
  pats_q4:         content.field_pats_q4,
  pats_ot:         content.field_pats_ot,
  opp_q1:          content.field_opp_q1,
  opp_q2:          content.field_opp_q2,
  opp_q3:          content.field_opp_q3,
  opp_q4:          content.field_opp_q4,
  opp_ot:          content.field_opp_ot,
} only %}
