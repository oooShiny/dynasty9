{#
/**
 * @file
 * Thin bridge → dynasty_tw:game-full SDC.
 *
 * The game_links slot is built here because it needs conditional URL extraction
 * from field render arrays (field_youtube_highlights[0]['#url'], etc.) that
 * cannot be done inside the SDC after rendering.
 */
#}

{# Build the game links block — URL extraction must happen pre-render. #}
{% set game_links %}
  <div id="game-links" class="flex items-center justify-around py-10">
    {% if content.field_pfr_link|render %}
      <a href="{{ content.field_pfr_link|render|trim }}" class="p-4 bg-green-900 text-white text-center">View game on PFR</a>
    {% endif %}
    {% if content.field_youtube_highlights|render %}
      <a href="{{ content.field_youtube_highlights[0]['#url'] }}" class="p-4 bg-red-600 text-white text-center">Youtube Highlights</a>
    {% endif %}
    {% if content.field_youtube_game_link|render %}
      <a href="{{ content.field_youtube_game_link|render|trim }}" class="bg-white border border-red-600 p-4 text-center text-red-600">Youtube Game Video</a>
    {% endif %}
  </div>
{% endset %}

{% include 'dynasty_tw:game-full' with {
  url:            url,
  label:          label,
  ot:             ot,
  vs:             vs,
  team_css:       team_css,
  opp_name:       opp_name,
  opp_short:      opp_short,
  season:         season,
  schema_date:    schema_date,
  schema_city:    schema_city,
  schema_state:   schema_state,
  schema_opp:     schema_opp,
  schema_name:    schema_name,
  playoff:        playoff,
  qbs:            qbs,

  highlight_video:    content.field_highlight_video_url,
  patriots_score:     content.field_patriots_score,
  opponent_score:     content.field_opponent_score,
  game_date:          content.field_date,
  pats_q1:            content.field_pats_q1,
  pats_q2:            content.field_pats_q2,
  pats_q3:            content.field_pats_q3,
  pats_q4:            content.field_pats_q4,
  pats_ot:            content.field_pats_ot,
  opp_q1:             content.field_opp_q1,
  opp_q2:             content.field_opp_q2,
  opp_q3:             content.field_opp_q3,
  opp_q4:             content.field_opp_q4,
  opp_ot:             content.field_opp_ot,
  game_links:         game_links,
  starting_qb:        content.field_starting_qb,
  brady_completions:  content.field_completions,
  brady_attempts:     content.field_attempts,
  brady_yards:        content.field_passing_yards,
  brady_tds:          content.field_passing_tds,
  brady_ints:         content.field_passing_ints,
  passer_rating:      content.field_passer_rating,
  game_summary:       content.field_game_summary,
  game_screenshots:   content.field_game_screenshots,
  game_video:         content.field_game_video,
  other_media:        content.field_other_videos,
} only %}
