{#
/**
 * @file
 * Thin bridge → dynasty_tw:podcast-card SDC.
 *
 * Variables from dynasty_tw_preprocess_node() (podcast_episode bundle):
 *   - ep_art:  Cover image URL (preprocess).
 *   - mp3:     Acast episode slug (preprocess, not used in card view).
 *
 * game_node_url requires render-array introspection (content.field_game renders
 * as the node ID with the entity-id formatter), so it must be extracted here.
 */
#}

{# Extract the related game node path before field rendering. #}
{% set game_node_url = content.field_game|render|trim ? 'node/' ~ content.field_game|render|trim : '' %}

{% include 'dynasty_tw:podcast-card' with {
  url:           url,
  label:         label,
  ep_art:        ep_art,
  game_node_url: game_node_url,

  audio_player: content.field_mp3,
  subtitle:     content.field_subtitle,
  duration:     content.field_duration,
  body:         content.body,
} only %}
