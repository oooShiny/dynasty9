{#
/**
 * @file
 * Thin bridge → dynasty_tw:highlight-card-horizontal SDC.
 *
 * Variables from dynasty_tw_preprocess_node():
 *   - td:         1 if touchdown (red bg), 0 otherwise (blue bg).
 *   - video_file: Skiv CDN video file ID.
 *   - url, label: Standard node variables.
 *
 * Slots receive rendered Drupal field output. field_muse_video_id is already
 * wired to dynasty_tw:video with card_type='horizontal' via the field template.
 */
#}
{% include 'dynasty_tw:highlight-card-horizontal' with {
  url:        url,
  label:      label,
  td:         td ? 1 : 0,
  video_file: video_file,
  video:      content.field_muse_video_id,
  game:       content.field_game,
  yards_gained: content.field_yards_gained,
  play_type:  content.field_play_type,
} only %}
