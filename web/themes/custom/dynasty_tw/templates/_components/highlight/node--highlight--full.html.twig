{#
/**
 * @file
 * Thin bridge → dynasty_tw:highlight-full SDC.
 *
 * Variables from dynasty_tw_preprocess_node():
 *   - muse_id:    Skiv.com clip ID for the shareable link.
 *   - video_file: Skiv CDN file ID for the direct download link.
 *
 * field_muse_video_id is already wired to dynasty_tw:video (card_type='none',
 * i.e. full 16:9 wrapper) via the field template.
 */
#}
{% include 'dynasty_tw:highlight-full' with {
  muse_id:    muse_id,
  video_file: video_file,
  video:             content.field_muse_video_id,
  play_description:  content.field_play_description,
  players_involved:  content.field_players_involved,
  game:              content.field_game,
} only %}
