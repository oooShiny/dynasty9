{#
/**
 * @file
 * Thin bridge → dynasty_tw:highlight-card SDC.
 *
 * Variables from dynasty_tw_preprocess_node():
 *   - td:         1 if this play scored a touchdown (red bg), 0 otherwise (blue bg).
 *   - video_file: Skiv.com video file ID for the CDN download URL (may be empty).
 *   - url:        Node canonical URL.
 *   - label:      Node title.
 *
 * Slots:
 *   - video: field_muse_video_id rendered output (already wired to dynasty_tw:video
 *            with card_type='vertical' via field--field-muse-video-id.html.twig).
 *   - game:  field_game rendered output.
 */
#}
{% include 'dynasty_tw:highlight-card' with {
  url:        url,
  label:      label,
  td:         td ? 1 : 0,
  video_file: video_file,
  video:      content.field_muse_video_id,
  game:       content.field_game,
} only %}
