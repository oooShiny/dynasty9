{#
/**
 * @file
 * Thin bridge → dynasty_tw:media-embed SDC.
 *
 * card_media|file_uri and image_style() must be applied here (in Twig context
 * that has the full Drupal Twig extensions) before passing the resolved URL
 * into the SDC.
 *
 * Preprocess variables:
 *   - card_media:     Loaded Media entity (or null).
 *   - card_img_style: Image style machine name.
 *   - image_css:      Tailwind classes for the <img> element.
 */
#}
{% set media_uri = card_media|file_uri %}
{% set image_src = media_uri ? media_uri|image_style(card_img_style) : '' %}

{% include 'dynasty_tw:media-embed' with {
  image_src: image_src,
  image_css: image_css,
} only %}
