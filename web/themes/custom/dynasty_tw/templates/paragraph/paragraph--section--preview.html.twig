{#
/**
 * @file
 * Thin bridge → dynasty_tw:section-preview SDC.
 *
 * Drupal-specific operations resolved here before the SDC boundary:
 *   - paragraph.bundle|clean_class → type_class
 *   - view_mode|clean_class        → view_mode_class
 *   - paragraph.isPublished()      → published
 *
 * Preprocess variable: bg_color.
 */
#}

{% set type_class      = 'paragraph--type--' ~ paragraph.bundle|clean_class %}
{% set view_mode_class = view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class : '' %}
{% set published       = paragraph.isPublished() %}

{% set preview_content %}
  {{ content|without('field_background_color', 'field_full_width_section') }}
{% endset %}

{% include 'dynasty_tw:section-preview' with {
  bg_color:        bg_color,
  type_class:      type_class,
  view_mode_class: view_mode_class,
  published:       published,
  preview_content: preview_content,
} only %}
