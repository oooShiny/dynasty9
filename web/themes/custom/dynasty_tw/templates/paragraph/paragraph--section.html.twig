{#
/**
 * @file
 * Thin bridge → dynasty_tw:section SDC.
 *
 * Drupal-specific operations that cannot be done inside the SDC are resolved
 * here:
 *   - paragraph.bundle|clean_class → type_class
 *   - view_mode|clean_class        → view_mode_class
 *   - paragraph.isPublished()      → published
 *   - content.field_anchor_id[0]['#context']['value'] → anchor_id
 *   - content|without(...)         → section_content slot
 *
 * Preprocess variables: bg_color, text_color, full_width, section_border.
 */
#}

{% set type_class      = 'paragraph--type--' ~ paragraph.bundle|clean_class %}
{% set view_mode_class = view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class : '' %}
{% set published       = paragraph.isPublished() %}
{% set anchor_id       = content.field_anchor_id|render ? content.field_anchor_id[0]['#context']['value'] : '' %}

{% set section_content %}
  {{ content|without('field_background_color', 'field_full_width_section', 'field_anchor_id', 'field_section_border') }}
{% endset %}

{% include 'dynasty_tw:section' with {
  bg_color:       bg_color,
  text_color:     text_color,
  full_width:     full_width ? true : false,
  section_border: section_border,
  type_class:     type_class,
  view_mode_class: view_mode_class,
  published:      published,
  anchor_id:      anchor_id,
  section_content: section_content,
} only %}
