{#
/**
 * @file
 * Thin bridge → dynasty_tw:article-card SDC.
 *
 * Preprocess variables:
 *   - card_style:      "blog" or a Tailwind class string.
 *   - card_link:       Resolved URL (from linked article or field_card_title link).
 *   - card_title:      Plain-text card heading.
 *   - article_summary: Body summary from the linked article node (may be null).
 */
#}
{% include 'dynasty_tw:article-card' with {
  card_style:      card_style,
  card_link:       card_link,
  card_title:      card_title,
  article_summary: article_summary,
  card_blurb:      content.field_card_blurb,
} only %}
